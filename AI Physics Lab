// AI ANALYSIS
function generateAIAnalysis() {

    const type = document.getElementById("experiment").value;

    let text = "";


    if(type === "motion") {

        const u = Number(document.getElementById("u").value);
        const a = Number(document.getElementById("a").value);
        const t = Number(document.getElementById("t").value);

        const s = u * t + 0.5 * a * t * t;

        text =
            `AI талдауы: Экспериментте бастапқы жылдамдық ${u} м/с, ` +
            `үдеу ${a} м/с² және уақыт ${t} с ретінде алынды. ` +
            `Есептеу нәтижесінде орын ауыстыру ${s.toFixed(2)} м болды. ` +
            `Үдеу мен уақыттың өсуі орын ауыстырудың артуына әсер етеді.`;

    }


    if(type === "ohm") {

        const U = Number(document.getElementById("voltage").value);
        const R = Number(document.getElementById("resistance").value);
        const I = U / R;

        text =
            `AI талдауы: U = ${U} В және R = ${R} Ω болғанда ` +
            `I = ${I.toFixed(2)} A. ` +
            `Бұл нәтиже Ом заңының I = U/R формуласымен сәйкес келеді. ` +
            `Кедергіні арттырғанда ток күші төмендейді.`;

    }


    if(type === "force") {

        const m = Number(document.getElementById("mass").value);
        const a = Number(document.getElementById("forceA").value);
        const F = m * a;

        text =
            `AI талдауы: Дененің массасы ${m} кг, үдеуі ${a} м/с². ` +
            `Нәтижесінде күш ${F.toFixed(2)} Н болды. ` +
            `Масса мен үдеу арасында күшке тура пропорционалдық байланыс бар.`;

    }


    document.getElementById("aiAnalysis").innerText = text;

}



// QUIZ
function quizAnswer(button, correct) {

    const feedback =
        document.getElementById("quizFeedback");


    feedback.classList.remove(
        "hidden",
        "bg-emerald-100",
        "text-emerald-800",
        "bg-rose-100",
        "text-rose-800"
    );


    if(correct) {

        feedback.classList.add(
            "bg-emerald-100",
            "text-emerald-800"
        );

        feedback.innerText =
            "✓ Дұрыс! Үдеу артқан сайын белгілі уақыттағы орын ауыстыру да артады.";

    } else {

        feedback.classList.add(
            "bg-rose-100",
            "text-rose-800"
        );

        feedback.innerText =
            "✗ Қате. Формулаға назар аударыңыз: s = ut + ½at².";

    }

}



