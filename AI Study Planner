<script>

let tasks = [];


// ADD TASK

function addTask() {

    const subject =
        document.getElementById("subject").value;

    const taskName =
        document.getElementById("task").value.trim();

    const deadline =
        document.getElementById("deadline").value;

    const hours =
        Number(document.getElementById("hours").value);

    const priority =
        document.getElementById("priority").value;


    if(!taskName) {

        alert("Тапсырма атауын енгізіңіз!");

        return;

    }


    tasks.push({

        subject: subject,

        name: taskName,

        deadline: deadline || "Дедлайн жоқ",

        hours: hours,

        priority: priority,

        completed: false

    });


    document.getElementById("task").value = "";


    renderTasks();

    updateStats();

}



// RENDER TASKS

function renderTasks() {

    const list =
        document.getElementById("taskList");


    if(tasks.length === 0) {

        list.innerHTML = `

            <div class="text-center py-10 text-slate-400">

                <i class="fa-solid fa-clipboard-list text-3xl mb-3"></i>

                <p class="text-xs">
                    Әзірге тапсырмалар жоқ
                </p>

            </div>

        `;

        return;

    }


    const priorityOrder = {

        high: 1,

        medium: 2,

        low: 3

    };


    const sorted =
        [...tasks].sort(
            (a,b) =>
            priorityOrder[a.priority] -
            priorityOrder[b.priority]
        );


    list.innerHTML =
        sorted.map((task, index) => {


            let color = "";

            let badge = "";


            if(task.priority === "high") {

                color =
                    "border-red-200 bg-red-50";

                badge =
                    "bg-red-100 text-red-700";

            }


            if(task.priority === "medium") {

                color =
                    "border-amber-200 bg-amber-50";

                badge =
                    "bg-amber-100 text-amber-700";

            }


            if(task.priority === "low") {

                color =
                    "border-emerald-200 bg-emerald-50";

                badge =
                    "bg-emerald-100 text-emerald-700";

            }


            return `

                <div class="border ${color}
                            rounded-xl p-4">

                    <div class="flex items-start gap-3">

                        <input type="checkbox"
                               ${task.completed ? "checked" : ""}
                               onchange="completeTask(${index})"
                               class="mt-1 w-4 h-4 accent-violet-600">

                        <div class="flex-1">

                            <div class="flex items-center
                                        justify-between gap-2">

                                <h4 class="font-bold text-sm
                                           ${task.completed ? "line-through text-slate-400" : ""}">

                                    ${task.name}

                                </h4>

                                <span class="text-[10px]
                                             px-2 py-1 rounded-full
                                             font-semibold ${badge}">

                                    ${task.priority === "high"
                                        ? "HIGH"
                                        : task.priority === "medium"
                                        ? "MEDIUM"
                                        : "LOW"}

                                </span>

                            </div>


                            <div class="flex flex-wrap gap-3 mt-2
                                        text-[10px] text-slate-500">

                                <span>
                                    <i class="fa-solid fa-book mr-1"></i>
                                    ${task.subject}
                                </span>

                                <span>
                                    <i class="fa-regular fa-clock mr-1"></i>
                                    ${task.hours} сағ.
                                </span>

                                <span>
                                    <i class="fa-regular fa-calendar mr-1"></i>
                                    ${task.deadline}
                                </span>

                            </div>

                        </div>


                        <button onclick="deleteTask(${index})"
                                class="text-slate-400
                                       hover:text-red-500">

                            <i class="fa-solid fa-trash text-xs"></i>

                        </button>

                    </div>

                </div>

            `;

        }).join("");

}



// COMPLETE TASK

function completeTask(index) {

    tasks[index].completed =
        !tasks[index].completed;

    renderTasks();

    updateStats();

}



// DELETE TASK

function deleteTask(index) {

    tasks.splice(index,1);

    renderTasks();

    updateStats();

}



// STATISTICS

function updateStats() {

    const count =
        tasks.length;


    const total =
        tasks.reduce(
            (sum, task) =>
            sum + task.hours,
            0
        );


    const completed =
        tasks.filter(
            task => task.completed
        ).length;


    const progress =
        count === 0
        ? 0
        : Math.round(
            completed / count * 100
        );


    document.getElementById("taskCount")
        .innerText = count;


    document.getElementById("totalHours")
        .innerText = total;


    document.getElementById("progressText")
        .innerText = progress + "%";


    document.getElementById("progressBar")
        .style.width = progress + "%";

}



// AI PLAN

function generatePlan() {

    const advice =
        document.getElementById("aiAdvice");


    if(tasks.length === 0) {

        advice.innerText =
            "Алдымен кемінде бір оқу тапсырмасын қосыңыз. AI сол тапсырмалардың көлемі мен приоритетін талдап, оқу ретін ұсынады.";

        return;

    }


    const high =
        tasks.filter(
            t => t.priority === "high"
        ).length;


    const totalHours =
        tasks.reduce(
            (sum,t) =>
            sum + t.hours,
            0
        );


    if(high >= 2) {

        advice.innerText =
            `AI ұсынысы: Сізде ${high} жоғары приоритетті тапсырма бар. ` +
            `Алдымен дедлайны жақын және маңызды тапсырмаларды орындаңыз. ` +
            `Жалпы жоспарланған оқу уақыты — ${totalHours} сағат. ` +
            `Әр 45–50 минут сайын қысқа үзіліс жасаған тиімді.`;

    }

    else {

        advice.innerText =
            `AI ұсынысы: Оқу жүктемеңіз салыстырмалы түрде басқарылатын деңгейде. ` +
            `Барлық тапсырмаларға шамамен ${totalHours} сағат қажет. ` +
            `Күн сайын аз мөлшерде орындап отыру соңғы күндегі жүктемені азайтады.`;

    }

}



// GPA

function calculateGPA() {

    const current =
        Number(
            document.getElementById("currentGpa").value
        );


    const target =
        Number(
            document.getElementById("targetGpa").value
        );


    const result =
        document.getElementById("gpaResult");


    if(current >= target) {

        result.innerHTML =
            "✓ Қазіргі GPA мақсатты көрсеткіштен жоғары немесе тең.";

        result.className =
            "mt-4 text-center text-sm text-emerald-400";

        return;

    }


    const difference =
        target - current;


    result.innerHTML =
        `Мақсатқа дейінгі айырмашылық: <b>${difference.toFixed(2)}</b><br>
         Жоғары нәтижелі бағаларға көбірек назар аударыңыз.`;

    result.className =
        "mt-4 text-center text-sm text-violet-300";

}



// CHECKLIST

function updateChecklist() {

    const checks =
        document.querySelectorAll(
            '.space-y-2 input[type="checkbox"]'
        );


    let completed = 0;


    checks.forEach(
        check => {

            if(check.checked) {
                completed++;
            }

        }
    );


    const total =
        checks.length;


    const percent =
        total === 0
        ? 0
        : completed / total * 100;


    document.getElementById("checkProgress")
        .innerText =
        `${completed} / ${total}`;


    document.getElementById("checkBar")
        .style.width =
        percent + "%";

}



// START

window.onload = function() {

    updateStats();

};

