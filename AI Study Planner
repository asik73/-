                        </div>

                    </div>

                </div>


                <div class="grid grid-cols-2 gap-3 mt-4">

                    <div class="bg-slate-50 rounded-xl p-3 text-center">

                        <span class="text-[10px] text-slate-400">
                            Тапсырма
                        </span>

                        <p id="taskCount"
