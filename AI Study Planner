            <div class="flex justify-between items-center mb-4">

                <h3 class="font-bold text-sm">
                    <i class="fa-solid fa-chart-pie text-violet-600 mr-2"></i>
                    Study Statistics
                </h3>

                <span class="text-[10px] bg-violet-100
                             text-violet-700 px-2 py-1 rounded-full">

